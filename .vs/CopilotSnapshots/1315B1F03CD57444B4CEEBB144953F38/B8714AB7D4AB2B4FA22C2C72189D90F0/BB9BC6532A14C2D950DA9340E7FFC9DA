function getOtherPlayers(mode = getSceneMode()) {
  if (!sceneState?.roomUsers?.length) {
    return [];
  }

  const others = sceneState.roomUsers.filter(u => u.id !== currentUserId);
  if (!others.length) {
    return [];
  }
  const groundY = mode === 'room' ? getRoomGeometry().floorY : FLOOR_Y;
  const interactables = getInteractables(mode);
  const fallbackMinX = interactables.length ? (mode === 'lobby' ? interactables[0].x - 150 : interactables[0].x - 40) : 40;
  const fallbackMaxX = interactables.length
    ? (mode === 'lobby' ? interactables[0].x + 150 : interactables[interactables.length - 1].x + 40)
    : gameCanvas.width - 40;

  return others.map((u, i) => {
    const fallbackX = clamp(fallbackMinX + 50 + i * 56, fallbackMinX + 24, fallbackMaxX - 24);
    return {
      id: u.id,
      name: u.name,
      x: Number.isFinite(u.posX) ? u.posX : fallbackX,
      y: Number.isFinite(u.posY) ? Math.min(u.posY, groundY) : groundY
    };
  });
}

function renderScene() {
  sceneCtx.fillStyle = '#000';
  sceneCtx.fillRect(0, 0, gameCanvas.width, gameCanvas.height);

  if (!isJoined) {
    updateJoinImeInput();
    updateChatImeInput();
    renderLoginCanvas();
    return;
  }

  updateJoinImeInput();
  updateChatImeInput();

  const mode = getSceneMode();
  if (mode === 'none') {
    sceneHint.textContent = 'Move with A/D or \u2190/\u2192, jump with W/\u2191/Space. Press E to interact, T to chat.';
    sceneCtx.fillStyle = '#fff';
    sceneCtx.font = '16px "Microsoft YaHei", "PingFang SC", sans-serif';
    sceneCtx.fillText('Graphical scene is loading...', 20, 32);
    renderInventoryHUD();
    renderUiButtons();
    renderStairsMenu();
    renderRoomSettingsPanel();
    renderSystemMessagesPanel();
    renderFriendPanel();
    renderTeleportPanel();
    renderChatPanel();
    renderCanvasNotices();
    return;
  }

  const interactables = getInteractables(mode);
  const nearest = getNearestInteractable(interactables);
  const otherPlayers = getOtherPlayers(mode);
  sceneHint.textContent = describeInteractable(nearest);

  if (mode === 'corridor' || mode === 'lobby') {
    const worldMaxX = interactables[interactables.length - 1].x + 80;
    const worldWidth = Math.max(gameCanvas.width, worldMaxX + 80);
    const cameraX = clamp(player.x - gameCanvas.width / 2, 0, worldWidth - gameCanvas.width);
    const tileStart = Math.floor((cameraX - TILE_SIZE) / TILE_SIZE);
    const tileEnd = Math.ceil((cameraX + gameCanvas.width + TILE_SIZE) / TILE_SIZE);

    for (let i = tileStart; i <= tileEnd; i += 1) {
      const drawX = i * TILE_SIZE - cameraX;
      drawSprite(textures.wallpaperUpper, drawX, FLOOR_Y - 96, TILE_SIZE, TILE_SIZE, '#111');
      drawSprite(textures.wallpaperMiddle, drawX, FLOOR_Y - 64, TILE_SIZE, TILE_SIZE, '#1a1a1a');
      drawSprite(textures.wallpaperMiddle, drawX, FLOOR_Y - 32, TILE_SIZE, TILE_SIZE, '#1a1a1a');
      drawSprite(textures.wallpaperLower, drawX, FLOOR_Y, TILE_SIZE, TILE_SIZE, '#242424');
      drawSprite(textures.floor, drawX, FLOOR_Y, TILE_SIZE, TILE_SIZE, '#464646');
    }

    for (const item of interactables) {
      const drawX = item.x - cameraX - DOOR_WIDTH / 2;
      if (item.type === 'agent') {
        // draw agent sprite
        const img = textures.agentRobot;
        if (img) {
          sceneCtx.drawImage(img, item.x - cameraX - 16, FLOOR_Y - 48, 32, 32);
        } else {
          sceneCtx.fillStyle = '#8d6e63';
          sceneCtx.fillRect(item.x - cameraX - 12, FLOOR_Y - 24, 24, 24);
        }
        drawDoorLabel(item.ownerName || 'Agent', item.x - cameraX, FLOOR_Y - 42);
        continue;
      }

      if (mode === 'lobby') {
        // In lobby, draw door sprite for stairs to keep the staircase entrance visible
        if (item.type === 'stairs') {
          drawSprite(textures.door, drawX, FLOOR_Y - (DOOR_HEIGHT - TILE_SIZE), DOOR_WIDTH, DOOR_HEIGHT, '#6b4a2d');
          drawDoorLabel(STAIRS_LABEL, item.x - cameraX, FLOOR_Y - 42);
          continue;
        }
        // For other lobby items (community), draw label only
        if (item.type === 'community') {
          drawDoorLabel(COMMUNITY_SPACE_LABEL, item.x - cameraX, FLOOR_Y - 42);
          continue;
        }
        // fallback: draw label
        drawDoorLabel(`${item.doorplate}: ${item.ownerName}`, item.x - cameraX, FLOOR_Y - 42);
        continue;
      }

      // default behavior for corridor/room: draw door sprite then labels
      drawSprite(textures.door, drawX, FLOOR_Y - (DOOR_HEIGHT - TILE_SIZE), DOOR_WIDTH, DOOR_HEIGHT, '#6b4a2d');
      if (item.type === 'stairs') {
        drawDoorLabel(STAIRS_LABEL, item.x - cameraX, FLOOR_Y - 42);
      } else if (item.type === 'community') {
        drawDoorLabel(COMMUNITY_SPACE_LABEL, item.x - cameraX, FLOOR_Y - 42);
      } else {
        drawDoorLabel(`${item.doorplate}: ${item.ownerName}`, item.x - cameraX, FLOOR_Y - 42);
      }
    }

    if (nearest) {
      const drawX = nearest.x - cameraX - DOOR_WIDTH / 2;
      if (nearest.type === 'agent') {
        // For agent, don't draw yellow border; brighten area and redraw agent to appear highlighted
        sceneCtx.fillStyle = 'rgba(255,255,255,0.12)';
        sceneCtx.fillRect(drawX - 2, FLOOR_Y - (DOOR_HEIGHT - TILE_SIZE) - 2, DOOR_WIDTH + 4, DOOR_HEIGHT + 4);
        // redraw agent sprite on top to make it appear brighter
        try {
          const img = textures.agentRobot;
          const ax = nearest.x - cameraX - 16;
          if (img) {
            sceneCtx.drawImage(img, ax, FLOOR_Y - 48, 32, 32);
          } else {
            sceneCtx.fillStyle = '#9e7b6a';
            sceneCtx.fillRect(ax + 4, FLOOR_Y - 24, 24, 24);
          }
        } catch (_e) {}
      } else {
        sceneCtx.strokeStyle = '#ffd54f';
        sceneCtx.lineWidth = 2;
        sceneCtx.strokeRect(drawX - 2, FLOOR_Y - (DOOR_HEIGHT - TILE_SIZE) - 2, DOOR_WIDTH + 4, DOOR_HEIGHT + 4);
      }
    }

    for (const other of otherPlayers) {
      drawSprite(textures.playerImage, other.x - cameraX - 16, other.y, 32, 32, '#6dc56d');
      drawPlayerName(other.name, other.x - cameraX, other.y - 6);
    }

    // draw room furnishings if any (in corridor/lobby we skip)
    for (const f of roomFurnishings || []) {
      if (!f) continue;
      const fx = (f.x || 0) - cameraX;
      const fy = (f.y != null) ? f.y : FLOOR_Y - 12;
      const icon = textures.itemIcons[f.id];
      if (icon === undefined) {
        (async id => {
          try {
            const img = await loadImage(`/textures/${id}.png`);
            if (img) textures.itemIcons[id] = img;
            else {
              const img2 = await loadImage(`/textures/item-${id}.png`);
              textures.itemIcons[id] = img2 || null;
            }
          } catch (_e) {
            textures.itemIcons[id] = null;
          }
        })(f.id);
      }
      if (icon) {
        sceneCtx.drawImage(icon, fx - 12, fy, 24, 24);
      } else {
        sceneCtx.fillStyle = '#8d6e63';
        sceneCtx.fillRect(fx - 12, fy, 24, 24);
      }
    }

    drawSprite(textures.playerImage, player.x - cameraX - 16, player.y, 32, 32, '#4ea7ff');
    drawPlayerName('You', player.x - cameraX, player.y - 6);
    renderInventoryHUD();
    renderUiButtons();
    renderStairsMenu();
    renderRoomSettingsPanel();
    renderSystemMessagesPanel();
    renderFriendPanel();
    renderTeleportPanel();
    renderChatPanel();
    renderCanvasNotices();
    return;
  }

  if (mode === 'room') {
    const room = getRoomGeometry();
    for (let i = 0; i < ROOM_WIDTH_TILES; i += 1) {
      const drawX = room.left + i * TILE_SIZE;
      drawSprite(textures.wallpaperUpper, drawX, room.top, TILE_SIZE, TILE_SIZE, '#111');
      drawSprite(textures.wallpaperMiddle, drawX, room.top + TILE_SIZE, TILE_SIZE, TILE_SIZE, '#1a1a1a');
      drawSprite(textures.wallpaperMiddle, drawX, room.top + TILE_SIZE * 2, TILE_SIZE, TILE_SIZE, '#1a1a1a');
      drawSprite(textures.wallpaperMiddle, drawX, room.top + TILE_SIZE * 3, TILE_SIZE, TILE_SIZE, '#1a1a1a');
      drawSprite(textures.wallpaperLower, drawX, room.floorY, TILE_SIZE, TILE_SIZE, '#242424');
      drawSprite(textures.floor, drawX, room.floorY, TILE_SIZE, TILE_SIZE, '#464646');
    }

    const exit = interactables[0];
    const doorX = exit.x - DOOR_WIDTH / 2;
    drawSprite(textures.door, doorX, room.floorY - (DOOR_HEIGHT - TILE_SIZE), DOOR_WIDTH, DOOR_HEIGHT, '#6b4a2d');
    drawDoorLabel(EXIT_LABEL, exit.x, room.floorY - 42);

    if (nearest?.type === 'exit') {
      sceneCtx.strokeStyle = '#ffd54f';
      sceneCtx.lineWidth = 2;
      sceneCtx.strokeRect(doorX - 2, room.floorY - (DOOR_HEIGHT - TILE_SIZE) - 2, DOOR_WIDTH + 4, DOOR_HEIGHT + 4);
    }

    // draw room furnishings for this room
    for (const f of roomFurnishings || []) {
      if (!f) continue;
      const fx = f.x || 0;
      const fy = (f.y != null) ? f.y : room.floorY - 12;
      const icon = textures.itemIcons[f.id];
      if (icon === undefined) {
        (async id => {
          try {
            const img = await loadImage(`/textures/${id}.png`);
            if (img) textures.itemIcons[id] = img;
            else {
              const img2 = await loadImage(`/textures/item-${id}.png`);
              textures.itemIcons[id] = img2 || null;
            }
          } catch (_e) {
            textures.itemIcons[id] = null;
          }
        })(f.id);
      }
      if (icon) {
        sceneCtx.drawImage(icon, fx - 12, fy, 24, 24);
      } else {
        sceneCtx.fillStyle = '#8d6e63';
        sceneCtx.fillRect(fx - 12, fy, 24, 24);
      }
    }

    for (const other of otherPlayers) {
      drawSprite(textures.playerImage, other.x - 16, other.y, 32, 32, '#6dc56d');
      drawPlayerName(other.name, other.x, other.y - 6);
    }

    drawSprite(textures.playerImage, player.x - 16, player.y, 32, 32, '#4ea7ff');
    drawPlayerName('You', player.x, player.y - 6);
    renderInventoryHUD();
    renderUiButtons();
    renderStairsMenu();
    renderRoomSettingsPanel();
    renderSystemMessagesPanel();
    renderFriendPanel();
    renderTeleportPanel();
    renderChatPanel();
    renderCanvasNotices();
  }
}

function getGroundY(mode = getSceneMode()) {
  if (mode === 'room') {
    return getRoomGeometry().floorY;
  }
  return FLOOR_Y;
}

function syncState(state) {
  const previousState = sceneState;
  sceneState = state;
  areaUserDirectory = Array.isArray(state.areaUsers) ? state.areaUsers : [];
  friendList = Array.isArray(state.friends) ? state.friends : [];
  blockedFriendList = Array.isArray(state.blockedFriends) ? state.blockedFriends : [];
  systemMessagesData = normalizeSystemMessages(state.systemMessages);
  unreadSystemMessageCount = Number.isInteger(state.unreadSystemMessageCount) ? state.unreadSystemMessageCount : 0;
  onlineFriendLocations = Array.isArray(state.onlineFriends) ? state.onlineFriends : [];
  if (!isRoomSettingsOpen || !isRoomSettingsDirty) {
    myRoomSettings = {
      defaultAccess: state.myRoomSettings?.defaultAccess === 'deny' ? 'deny' : 'allow',
      whitelist: Array.isArray(state.myRoomSettings?.whitelist) ? state.myRoomSettings.whitelist : [],
      blacklist: Array.isArray(state.myRoomSettings?.blacklist) ? state.myRoomSettings.blacklist : []
    };
  }
  roomSettingsUserIndex = clamp(roomSettingsUserIndex, 0, Math.max(0, areaUserDirectory.length - 1));
  roomSettingsScrollOffset = ensureIndexVisible(roomSettingsUserIndex, 7, areaUserDirectory.length, roomSettingsScrollOffset);
  locationInfo.textContent = `Current area: ${areaName(state.areaId)} / ${roomName(state.roomId)}`;
  scenePanel.classList.remove('hidden');

  selfInfo.textContent = selfInfo.textContent.split(' | ')[0];
  if (state.ownedRoom) {
    const ownedLabel = `Owned room: Floor ${state.ownedRoom.floor}, ${roomName(state.ownedRoom.roomId)}`;
    selfInfo.textContent = `${selfInfo.textContent.split(' | ')[0]} | ${ownedLabel}`;
  }

  const mode = getSceneMode(state);
  const previousMode = getSceneMode(previousState);
  const isSameLocation = previousState?.areaId === state.areaId && previousState?.roomId === state.roomId;
  if (!isSameLocation) {
    if (mode === 'corridor' && previousMode === 'room' && previousState?.areaId === state.areaId) {
      const previousRoomMatch = /^room-(\d+)$/.exec(previousState.roomId || '');
      if (previousRoomMatch) {
        player.x = getDoorX(Number(previousRoomMatch[1]));
      } else if ((previousState.roomId || '') === getCommunitySpaceRoomId()) {
        player.x = getCommunitySpaceX();
      }
    } else if (mode === 'corridor') {
      player.x = getDoorX(layout.residentCapacity) + (Number(layout.stairsOffsetX) || STAIRS_OFFSET_X);
    } else if (mode === 'lobby') {
      player.x = Math.round(gameCanvas.width / 2);
    } else if (mode === 'room') {
      const room = getRoomGeometry();
      player.x = room.left + 110;
    }

    player.y = getGroundY(mode);
    player.velocityX = 0;
    player.velocityY = 0;
    jumpBufferRemaining = 0;
    lastSentX = null;
    lastSentY = null;
    closeStairsMenu();
    closeRoomSettings();
      closeSystemMessagesPanel();
      closeFriendPanel();
      closeTeleportMenu();
    if (isChatPanelOpen) {
      stopMovement();
    }
  }

  usersList.innerHTML = '';
  state.roomUsers.forEach(u => {
    const li = document.createElement('li');
    if (u.role === 'resident') {
      li.textContent = `${u.name} (resident floor ${u.homeFloor}, doorplate ${u.doorplate})`;
    } else {
      li.textContent = `${u.name} (visitor)`;
    }
    usersList.appendChild(li);
  });
}

function updatePlayerPosition(dt) {
  if (!sceneState || !layout) {
    return;
  }

  const mode = getSceneMode();
  const interactables = getInteractables(mode);
  if (!interactables.length) {
    return;
  }

  let minX;
  let maxX;
  if (mode === 'room') {
    const room = getRoomGeometry();
    minX = room.left + 24;
    maxX = room.left + room.width - 24;
  } else if (mode === 'lobby') {
    minX = interactables[0].x - 150;
    maxX = interactables[0].x + 150;
  } else {
    minX = interactables[0].x - 40;
    maxX = interactables[interactables.length - 1].x + 40;
  }

  const groundY = getGroundY(mode);
  const isOnGround = player.y >= groundY - 0.5;
  jumpBufferRemaining = Math.max(0, jumpBufferRemaining - dt);
  const direction = (player.moveRight ? 1 : 0) - (player.moveLeft ? 1 : 0);
  const drag = isOnGround ? PLAYER_GROUND_DRAG : PLAYER_AIR_DRAG;

  player.velocityX += direction * PLAYER_ACCELERATION * dt;
  player.velocityX -= player.velocityX * drag * dt;
  player.velocityX = clamp(player.velocityX, -PLAYER_SPEED, PLAYER_SPEED);
  if (direction === 0 && Math.abs(player.velocityX) < 3) {
    player.velocityX = 0;
  }

  player.x = clamp(player.x + player.velocityX * dt, minX, maxX);
  if ((player.x <= minX && player.velocityX < 0) || (player.x >= maxX && player.velocityX > 0)) {
    player.velocityX = 0;
  }

  if (jumpBufferRemaining > 0 && isOnGround) {
    player.velocityY = PLAYER_JUMP_VELOCITY;
    jumpBufferRemaining = 0;
  }

  player.velocityY += PLAYER_GRAVITY * dt;
  player.y += player.velocityY * dt;
  if (player.y > groundY) {
    player.y = groundY;
    player.velocityY = 0;
  }
}

function syncPlayerPosition(timestamp) {
  if (!sceneState || !canSyncPlayerPosition || isStairsMenuOpen || isChatPanelOpen || isRoomSettingsOpen || isSystemMessagesOpen || isFriendPanelOpen || isTeleportMenuOpen) {
    return;
  }

  const now = timestamp || performance.now();
  if (now - lastSentPositionAt < POSITION_SYNC_INTERVAL_MS) {
    return;
  }

  const x = Math.round(player.x * 100) / 100;
  const y = Math.round(player.y * 100) / 100;
  if (lastSentX === x && lastSentY === y) {
    return;
  }

  lastSentPositionAt = now;
  lastSentX = x;
  lastSentY = y;
  send('player-move', { x, y });
}

function frame(timestamp) {
  const dt = Math.min(0.05, (timestamp - lastFrame) / 1000 || 0);
  lastFrame = timestamp;
  updatePlayerPosition(dt);
  syncPlayerPosition(timestamp);
  renderScene();
  requestAnimationFrame(frame);
}

function simulateHiddenPhysicsTick() {
  if (!document.hidden) {
    return;
  }
  const now = performance.now();
  const dt = Math.min(0.1, (now - lastFrame) / 1000 || 0);
  lastFrame = now;
  updatePlayerPosition(dt);
  syncPlayerPosition(now);
}

function catchUpPhysicsAfterVisibilityRestore() {
  const now = performance.now();
  let remaining = Math.min(2, (now - lastFrame) / 1000 || 0);
  const step = 1 / 60;
  while (remaining > 0) {
    const dt = Math.min(step, remaining);
    updatePlayerPosition(dt);
    remaining -= dt;
  }
  lastFrame = now;
  syncPlayerPosition(now);
}

async function init() {
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
  requestAnimationFrame(frame);
  setInterval(simulateHiddenPhysicsTick, HIDDEN_PHYSICS_INTERVAL_MS);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) {
      catchUpPhysicsAfterVisibilityRestore();
    }
  });
  window.addEventListener('blur', () => {
    stopMovement();
  });

  try {
    const res = await fetch('/api/layout');
    layout = await res.json();
    joinUi.homeFloor = layout.floors?.[0] || 1;
    joinUi.doorplate = 1;
    joinUi.areaId = layout.lobbies?.[0]?.id || `floor-${joinUi.homeFloor}`;
    fillOptions();
    nameInput.value = joinUi.name;
    roleSelect.value = joinUi.role;
    homeFloorSelect.value = String(joinUi.homeFloor);
    doorplateSelect.value = String(joinUi.doorplate);
    areaSelect.value = joinUi.areaId;
    restoreHistoryCheckbox.checked = joinUi.restoreHistory;
    updateJoinImeInput();
    updateChatImeInput();
  } catch (_err) {
    // Keep graphical login available even when layout API is temporarily unavailable.
  }

  await loadTextures();
  await loadSounds();

  const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
  ws = new WebSocket(`${protocol}://${window.location.host}`);

  ws.onmessage = e => {
    const data = JSON.parse(e.data);
    if (data.type === 'error') {
      if (data.payload?.message === 'Unknown command') {
        canSyncPlayerPosition = false;
        return;
      }
      pushCanvasNotice(data.payload.message, true);
      return;
    }
    if (data.type === 'chat') {
      addMessage(data.payload.sender, data.payload.text, data.payload.sender === 'System');
      return;
    }
    if (data.type === 'chat-history') {
      renderHistory(data.payload.messages || []);
      return;
    }
    if (data.type === 'info') {
      pushCanvasNotice(data.payload.message);
      addMessage('System', data.payload.message, true);
      return;
    }
    if (data.type === 'joined') {
      const me = data.payload;
      currentUserId = me.id;
      isJoined = true;
      selfInfo.textContent = me.role === 'resident'
        ? `User: ${me.name} (resident floor ${me.homeFloor}, doorplate ${me.doorplate})`
        : `User: ${me.name} (visitor)`;
      joinPanel.classList.add('hidden');
      chatPanel.classList.remove('hidden');
      return;
    }
    if (data.type === 'state') {
      syncState(data.payload);
      return;
    }
    if (data.type === 'room-users') {
      if (sceneState) {
        sceneState.roomUsers = data.payload?.roomUsers || [];
      }
    }
  };

  roleSelect.addEventListener('change', () => {
    residentFields.classList.toggle('hidden', roleSelect.value !== 'resident');
  });

  imeChatInput.addEventListener('compositionstart', () => {
    isChatComposing = true;
  });

  imeChatInput.addEventListener('compositionend', () => {
    isChatComposing = false;
    chatInputText = imeChatInput.value.slice(0, 120);
  });

  imeChatInput.addEventListener('input', () => {
    chatInputText = imeChatInput.value.slice(0, 120);
    if (imeChatInput.value !== chatInputText) {
      imeChatInput.value = chatInputText;
    }
  });

  joinBtn.addEventListener('click', () => {
    const payload = {
      name: nameInput.value,
      role: roleSelect.value,
      areaId: areaSelect.value,
      restoreHistory: restoreHistoryCheckbox.checked
    };
    if (roleSelect.value === 'resident') {
      payload.homeFloor = Number(homeFloorSelect.value);
      payload.doorplate = Number(doorplateSelect.value);
    }
    send('join', payload);
  });

  imeNameInput.addEventListener('compositionstart', () => {
    isJoinNameComposing = true;
  });

  imeNameInput.addEventListener('compositionend', () => {
    isJoinNameComposing = false;
    joinUi.name = imeNameInput.value.slice(0, 24);
  });

  imeNameInput.addEventListener('input', () => {
    joinUi.name = imeNameInput.value.slice(0, 24);
    if (imeNameInput.value !== joinUi.name) {
      imeNameInput.value = joinUi.name;
    }
  });

  gameCanvas.addEventListener('click', e => {
    if (!isJoined || !uiButtons.length) {
      return;
    }
    const rect = gameCanvas.getBoundingClientRect();
    const scaleX = gameCanvas.width / rect.width;
    const scaleY = gameCanvas.height / rect.height;
    const x = (e.clientX - rect.left) * scaleX;
    const y = (e.clientY - rect.top) * scaleY;

    for (const button of uiButtons) {
      const insideX = x >= button.x && x <= button.x + button.w;
      const insideY = y >= button.y && y <= button.y + button.h;
      if (!insideX || !insideY || button.disabled) {
        continue;
      }
      handleUiButtonClick(button.key);
      break;
    }
  });

  const handlePanelWheel = deltaY => {
    if (!isJoined) {
      return false;
    }

    const delta = deltaY > 0 ? 1 : deltaY < 0 ? -1 : 0;
    if (!delta) {
      return false;
    }

    if (isSystemMessagesOpen) {
      const list = normalizeSystemMessages(systemMessagesData).slice().reverse();
      if (!list.length) {
        return false;
      }
      systemMessageIndex = clamp(systemMessageIndex + delta, 0, list.length - 1);
      systemMessageScrollOffset = ensureIndexVisible(systemMessageIndex, 9, list.length, systemMessageScrollOffset);
      return true;
    }

    if (isFriendPanelOpen) {
      const candidates = getFriendPanelCandidates();
      if (!candidates.length) {
        return false;
      }
      friendPanelIndex = clamp(friendPanelIndex + delta, 0, candidates.length - 1);
      friendPanelScrollOffset = ensureIndexVisible(friendPanelIndex, 8, candidates.length, friendPanelScrollOffset);
      return true;
    }

    if (isTeleportMenuOpen) {
      if (!teleportOptions.length) {
        return false;
      }
      teleportIndex = clamp(teleportIndex + delta, 0, teleportOptions.length - 1);
      teleportScrollOffset = ensureIndexVisible(teleportIndex, 9, teleportOptions.length, teleportScrollOffset);
      return true;
    }

    if (isRoomSettingsOpen) {
      if (!areaUserDirectory.length) {
        return false;
      }
      roomSettingsUserIndex = clamp(roomSettingsUserIndex + delta, 0, areaUserDirectory.length - 1);
      roomSettingsScrollOffset = ensureIndexVisible(roomSettingsUserIndex, 7, areaUserDirectory.length, roomSettingsScrollOffset);
      return true;
    }

    // Allow scrolling chat when chat panel is open OR when chat input has focus
    if (isChatPanelOpen || (typeof imeChatInput !== 'undefined' && document.activeElement === imeChatInput)) {
      const maxChatOffset = Math.max(0, chatLog.length - 8);
      const chatDelta = deltaY > 0 ? -1 : 1;
      chatPanelScrollOffset = clamp(chatPanelScrollOffset + chatDelta, 0, maxChatOffset);
      return true;
    }

    // Inventory scrolling when no other panel is open
    if (!isSystemMessagesOpen && !isFriendPanelOpen && !isTeleportMenuOpen && !isRoomSettingsOpen && !isChatPanelOpen) {
      if (inventoryList && inventoryList.length) {
        inventoryIndex = clamp(inventoryIndex + delta, 0, inventoryList.length - 1);
        inventoryScrollOffset = ensureIndexVisible(inventoryIndex, INVENTORY_VISIBLE_ROWS, inventoryList.length, inventoryScrollOffset);
        return true;
      }
    }

    return false;
  };

  gameCanvas.addEventListener('wheel', e => {
    if (!isJoined) {
      return;
    }

    if (handlePanelWheel(e.deltaY)) {
      e.preventDefault();
    }
  }, { passive: false });

  imeChatInput.addEventListener('wheel', e => {
    if (handlePanelWheel(e.deltaY)) {
      e.preventDefault();
    }
  }, { passive: false });

  // Allow scrolling the DOM messages container with wheel and keep canvas state in sync
  if (messages) {
    messages.addEventListener('wheel', e => {
      if (handlePanelWheel(e.deltaY)) {
        // update DOM scroll according to chatPanelScrollOffset
        const rowHeight = 20;
        const maxChatOffset = Math.max(0, chatLog.length - 8);
        const offset = clamp(chatPanelScrollOffset, 0, maxChatOffset);
        if (offset === 0) {
          messages.scrollTop = messages.scrollHeight;
        } else {
          messages.scrollTop = Math.max(0, messages.scrollHeight - offset * rowHeight);
        }
        e.preventDefault();
      }
    }, { passive: false });
  }

  window.addEventListener('keydown', e => {
    if (!isJoined) {
      if (e.isComposing || isJoinNameComposing) {
        return;
      }

      const fields = getJoinFields();
      clampJoinFocus();
      const focused = fields[joinUi.focusIndex];

      if (e.key === 'ArrowUp' || e.key === 'Tab' && e.shiftKey) {
        joinUi.focusIndex = (joinUi.focusIndex - 1 + fields.length) % fields.length;
        updateJoinImeInput();
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 'Tab') {
        joinUi.focusIndex = (joinUi.focusIndex + 1) % fields.length;
        updateJoinImeInput();
        e.preventDefault();
        return;
      }

      if (focused?.key === 'name') {
        return;
      }

      if (e.key === 'ArrowLeft') {
        cycleJoinValue(focused?.key, -1);
        updateJoinImeInput();
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowRight') {
        cycleJoinValue(focused?.key, 1);
        updateJoinImeInput();
        e.preventDefault();
        return;
      }

      if (focused?.key === 'restoreHistory' && (e.key === ' ' || e.key === 'Enter')) {
        joinUi.restoreHistory = !joinUi.restoreHistory;
        e.preventDefault();
        return;
      }

      if (focused?.key === 'join' && e.key === 'Enter') {
        joinFromCanvas();
        e.preventDefault();
        return;
      }

      if (e.key === 'Enter') {
        if (focused?.type === 'select') {
          cycleJoinValue(focused.key, 1);
          e.preventDefault();
        }
      }
      return;
    }

    if (isChatPanelOpen) {
      if (e.key === 'Escape') {
        isChatPanelOpen = false;
        // leaving agent chat context if any
        isAgentChat = false;
        currentAgentId = null;
        currentAgentName = null;
        stopMovement();
        updateChatImeInput();
        e.preventDefault();
        return;
      }
      if (e.key === 'Enter' && !e.isComposing && !isChatComposing) {
        const text = chatInputText.trim();
        if (text) {
          if (isAgentChat && currentAgentId) {
            send('agent-chat', { agentId: currentAgentId, text });
          } else {
            send('chat', { text });
          }
          chatInputText = '';
          imeChatInput.value = '';
        }
        e.preventDefault();
        return;
      }
      return;
    }

    if (isSystemMessagesOpen) {
      const messages = normalizeSystemMessages(systemMessagesData).slice().reverse();
      if (e.key === 'Escape') {
        closeSystemMessagesPanel();
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') {
        if (messages.length) {
          systemMessageIndex = (systemMessageIndex - 1 + messages.length) % messages.length;
          systemMessageScrollOffset = ensureIndexVisible(systemMessageIndex, 9, messages.length, systemMessageScrollOffset);
        }
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') {
        if (messages.length) {
          systemMessageIndex = (systemMessageIndex + 1) % messages.length;
          systemMessageScrollOffset = ensureIndexVisible(systemMessageIndex, 9, messages.length, systemMessageScrollOffset);
        }
        e.preventDefault();
        return;
      }
      if ((e.key === 'a' || e.key === 'A') && !e.repeat) {
        handleSelectedSystemMessageAction('approve');
        e.preventDefault();
        return;
      }
      if ((e.key === 'd' || e.key === 'D') && !e.repeat) {
        handleSelectedSystemMessageAction('reject');
        e.preventDefault();
        return;
      }
      return;
    }

    if (isFriendPanelOpen) {
      const candidates = getFriendPanelCandidates();
      if (e.key === 'Escape') {
        closeFriendPanel();
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') {
        if (candidates.length) {
          friendPanelIndex = (friendPanelIndex - 1 + candidates.length) % candidates.length;
          friendPanelScrollOffset = ensureIndexVisible(friendPanelIndex, 8, candidates.length, friendPanelScrollOffset);
        }
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') {
        if (candidates.length) {
          friendPanelIndex = (friendPanelIndex + 1) % candidates.length;
          friendPanelScrollOffset = ensureIndexVisible(friendPanelIndex, 8, candidates.length, friendPanelScrollOffset);
        }
        e.preventDefault();
        return;
      }
      if (e.key === 'Enter') {
        const selected = candidates[friendPanelIndex];
        if (selected?.kind === 'player') {
          sendFriendRequestByName(selected.name);
        }
        e.preventDefault();
        return;
      }
      if ((e.key === 'b' || e.key === 'B') && !e.repeat) {
        const selected = candidates[friendPanelIndex];
        if (selected?.kind === 'friend') {
          sendFriendBlockToggleByName(selected.name);
        }
        e.preventDefault();
        return;
      }
      if ((e.key === 'n' || e.key === 'N') && !e.repeat) {
        const targetName = window.prompt('输入要申请好友的昵称：', '');
        if (targetName) {
          sendFriendRequestByName(targetName);
        }
        e.preventDefault();
      }
      return;
    }

    if (isTeleportMenuOpen) {
      if (e.key === 'Escape') {
        closeTeleportMenu();
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') {
        if (teleportOptions.length) {
          teleportIndex = (teleportIndex - 1 + teleportOptions.length) % teleportOptions.length;
          teleportScrollOffset = ensureIndexVisible(teleportIndex, 9, teleportOptions.length, teleportScrollOffset);
        }
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') {
        if (teleportOptions.length) {
          teleportIndex = (teleportIndex + 1) % teleportOptions.length;
          teleportScrollOffset = ensureIndexVisible(teleportIndex, 9, teleportOptions.length, teleportScrollOffset);
        }
        e.preventDefault();
        return;
      }
      if (e.key === 'Enter' || e.key === 'e' || e.key === 'E') {
        teleportToSelectedOption();
        closeTeleportMenu();
        e.preventDefault();
      }
      return;
    }

    if (isRoomSettingsOpen) {
      if (e.key === 'Escape') {
        closeRoomSettings();
        e.preventDefault();
        return;
      }

    if ((e.key === TELEPORT_KEY || e.key === TELEPORT_KEY.toLowerCase()) && !e.repeat) {
      openTeleportMenu();
      e.preventDefault();
      return;
    }
      if (e.key === 'Tab') {
        myRoomSettings.defaultAccess = myRoomSettings.defaultAccess === 'deny' ? 'allow' : 'deny';
        isRoomSettingsDirty = true;
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') {
        if (areaUserDirectory.length) {
          roomSettingsUserIndex = (roomSettingsUserIndex - 1 + areaUserDirectory.length) % areaUserDirectory.length;
          roomSettingsScrollOffset = ensureIndexVisible(roomSettingsUserIndex, 7, areaUserDirectory.length, roomSettingsScrollOffset);
        }
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') {
        if (areaUserDirectory.length) {
          roomSettingsUserIndex = (roomSettingsUserIndex + 1) % areaUserDirectory.length;
          roomSettingsScrollOffset = ensureIndexVisible(roomSettingsUserIndex, 7, areaUserDirectory.length, roomSettingsScrollOffset);
        }
        e.preventDefault();
        return;
      }

      const selected = getSelectedRoomSettingsUser();
      if ((e.key === 'a' || e.key === 'A') && selected) {
        toggleRoomSettingsList('whitelist', selected.name);
        e.preventDefault();
        return;
      }
      if ((e.key === 'd' || e.key === 'D') && selected) {
        toggleRoomSettingsList('blacklist', selected.name);
        e.preventDefault();
        return;
      }
      if ((e.key === 'x' || e.key === 'X' || e.key === 'Delete') && selected) {
        removeRoomSettingsUser(selected.name);
        e.preventDefault();
        return;
      }
      if (e.key === 'Enter') {
        saveRoomSettings();
        closeRoomSettings();
        e.preventDefault();
      }
      return;
    }

    if (isStairsMenuOpen) {
      if (e.key === 'Escape') {
        closeStairsMenu();
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') {
        stairsMenuIndex = (stairsMenuIndex - 1 + stairsMenuOptions.length) % stairsMenuOptions.length;
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') {
        stairsMenuIndex = (stairsMenuIndex + 1) % stairsMenuOptions.length;
        e.preventDefault();
        return;
      }
      if (e.key === 'Enter' || e.key === 'e' || e.key === 'E') {
        const selected = stairsMenuOptions[stairsMenuIndex];
        if (selected && selected.areaId !== sceneState?.areaId) {
          playSound('doorOpen');
          send('switch-area', { areaId: selected.areaId });
        }
        closeStairsMenu();
        e.preventDefault();
      }
      return;
    }

    if ((e.key === 't' || e.key === 'T') && !e.repeat) {
      isChatPanelOpen = true;
      chatPanelScrollOffset = 0;
      stopMovement();
      updateChatImeInput();
      e.preventDefault();
      return;
    }

    if ((e.key === 'r' || e.key === 'R') && !e.repeat) {
      handleClaimNearestRoom();
      e.preventDefault();
      return;
    }

    if ((e.key === 'h' || e.key === 'H') && !e.repeat) {
      send('clear-history', {});
      e.preventDefault();
      return;
    }

    if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') {
      player.moveLeft = true;
      e.preventDefault();
      return;
    }
    if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') {
      player.moveRight = true;
      e.preventDefault();
      return;
    }
    if ((e.key === 'f' || e.key === 'F') && !e.repeat) {
      // place item when in room and selected item is placeable
      const mode = getSceneMode();
      const selected = inventoryList && inventoryList[inventoryIndex];
      if (mode === 'room' && selected && selected.placeable) {
        const x = Math.round(player.x * 100) / 100;
        const y = Math.round(player.y * 100) / 100;
        send('place-item', { itemId: selected.id, slot: inventoryIndex, x, y });
        e.preventDefault();
        return;
      }
    }
    if ((e.key === 'e' || e.key === 'E') && !e.repeat) {
      // Prefer using selected inventory item over interacting with doors/stairs
      if (inventoryList && inventoryList.length) {
        const didUse = useSelectedItem();
        if (didUse) {
          e.preventDefault();
          return;
        }
      }
      handleInteract();
      e.preventDefault();
      return;
    }
    if ((e.key === 'w' || e.key === 'W' || e.key === 'ArrowUp' || e.code === 'Space') && !e.repeat) {
      jumpBufferRemaining = JUMP_BUFFER_SECONDS;
      e.preventDefault();
      return;
    }
  });

  window.addEventListener('keyup', e => {
    if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') {
      player.moveLeft = false;
      return;
    }
    if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') {
      player.moveRight = false;
    }
  });
}

init();
