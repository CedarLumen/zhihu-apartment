function getWrappedLines(text, maxWidth) {
  const words = String(text).split(/\s+/);
  const lines = [];
  let line = '';
  for (let n = 0; n < words.length; n++) {
    const testLine = line ? `${line} ${words[n]}` : words[n];
    const metrics = sceneCtx.measureText(testLine);
    const testWidth = metrics.width;
    if (testWidth > maxWidth && line) {
      lines.push(line);
      line = words[n];
    } else {
      line = testLine;
    }
  }
  if (line) lines.push(line);
  return lines;
}

function wrapTextToLines(text, maxWidth) {
  // normalize HTML <br> to newlines and split into paragraphs
  const normalized = String(text).replace(/<br\s*\/?>/gi, '\n');
  const paragraphs = normalized.split(/\r?\n/);
  const out = [];
  for (let p = 0; p < paragraphs.length; p += 1) {
    const para = paragraphs[p];
    if (!para) {
      // preserve blank line
      out.push('');
      continue;
    }
    const wrapped = getWrappedLines(para, maxWidth);
    if (wrapped.length) {
      out.push(...wrapped);
    } else {
      out.push('');
    }
  }
  return out;
}

// Basic Markdown renderer (safe-ish): supports **bold**, *italic*, `code`, and [link](http...)
function escapeHtml(str) {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderMarkdown(text) {
  if (!text) return '';
  // escape first
  let out = escapeHtml(text);
  // links [text](url) only allow http(s)
  out = out.replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, (m, t, u) => {
    const safeUrl = escapeHtml(u);
    return `<a href="${safeUrl}" target="_blank" rel="noopener noreferrer">${escapeHtml(t)}</a>`;
  });
  // bold **text**
  out = out.replace(/\*\*([^*]+)\*\*/g, (m, t) => `<strong>${t}</strong>`);
  // italic *text*
  out = out.replace(/\*([^*]+)\*/g, (m, t) => `<em>${t}</em>`);
  // inline code `code`
  out = out.replace(/`([^`]+)`/g, (m, t) => `<code>${escapeHtml(t)}</code>`);
  // preserve newlines
  out = out.replace(/\r?\n/g, '<br>');
  return out;
}

