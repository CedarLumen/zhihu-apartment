function renderSystemMessagesPanel() {
  if (!isSystemMessagesOpen) {
    return;
  }

  const width = 620;
  const height = 300;
  const left = Math.round((gameCanvas.width - width) / 2);
  const top = Math.round((gameCanvas.height - height) / 2);
  drawOverlayPanel(left, top, width, height);

  const messages = normalizeSystemMessages(systemMessagesData).slice().reverse();
  systemMessageIndex = clamp(systemMessageIndex, 0, Math.max(0, messages.length - 1));
  const selected = messages[systemMessageIndex] || null;

  sceneCtx.fillStyle = '#fff';
  sceneCtx.font = '16px "Microsoft YaHei", "PingFang SC", sans-serif';
  sceneCtx.fillText('System Messages', left + 16, top + 28);
  sceneCtx.font = '13px "Microsoft YaHei", "PingFang SC", sans-serif';
  sceneCtx.fillStyle = '#cfd8dc';
  sceneCtx.fillText('↑/↓ Select  Mouse Wheel Scroll  A Approve  D Reject  Esc Close', left + 16, top + height - 18);

  if (!messages.length) {
    sceneCtx.fillStyle = '#b0bec5';
    sceneCtx.fillText('No system messages.', left + 16, top + 66);
    return;
  }

  const visibleRows = 9;
  // Build a flattened list of lines for all messages so scrolling and
  // visibility can be handled per-line (messages have variable line counts).
  const LINE_HEIGHT = 20;
  const linesArray = [];
  const msgStartLineIndex = new Array(messages.length).fill(0);
  for (let mi = 0; mi < messages.length; mi += 1) {
    const item = messages[mi];
    const isSelectedMsg = selected && selected.id === item.id;
    const status = item.type === 'friend-request' ? `[${item.meta?.status || 'pending'}] ` : '';
    const prefix = isSelectedMsg ? '> ' : '  ';
    const text = `${prefix}${status}${item.text}`;
    const wrapped = wrapTextToLines(text, width - 44);
    msgStartLineIndex[mi] = linesArray.length;
    for (let li = 0; li < wrapped.length; li += 1) {
      linesArray.push({ msgIndex: mi, text: wrapped[li] });
    }
  }

  const totalLines = linesArray.length;
  // compute how many rows fit inside panel body area
  const headerSpace = 58; // same offset used previously
  const availableHeight = height - (headerSpace - 28) - 40; // leave some footer padding
  const rowsPerPage = Math.max(1, Math.floor(availableHeight / LINE_HEIGHT));

  // Ensure the selected message is visible: compute its line range and adjust offset
  let startLine = clamp(systemMessageScrollOffset, 0, Math.max(0, totalLines - rowsPerPage));
  if (selected) {
    const selIndex = messages.findIndex(m => m && m.id === selected.id);
    if (selIndex >= 0) {
      const selStart = msgStartLineIndex[selIndex];
      // find selEnd (next msg start or totalLines)
      const selEnd = (selIndex + 1 < messages.length) ? msgStartLineIndex[selIndex + 1] : totalLines;
      if (selStart < startLine) {
        startLine = selStart;
      } else if (selEnd > startLine + rowsPerPage) {
        startLine = Math.max(0, selEnd - rowsPerPage);
      }
    }
  }
  // persist back
  systemMessageScrollOffset = startLine;

  const endLine = Math.min(totalLines, startLine + rowsPerPage);
  let y = top + headerSpace;

  // For selected message highlight, compute its overall line range
  let selectedLineStart = -1;
  let selectedLineEnd = -1;
  if (selected) {
    const sidx = messages.findIndex(m => m && m.id === selected.id);
    if (sidx >= 0) {
      selectedLineStart = msgStartLineIndex[sidx];
      selectedLineEnd = (sidx + 1 < messages.length) ? msgStartLineIndex[sidx + 1] : totalLines;
    }
  }

  const visSelStart = selectedLineStart >= 0 ? Math.max(startLine, selectedLineStart) : -1;
  const visSelEnd = selectedLineEnd >= 0 ? Math.min(endLine, selectedLineEnd) : -1;
  // draw visible lines
  for (let li = startLine; li < endLine; li += 1) {
    const entry = linesArray[li];
    // draw selection background once at the first visible selected line
    if (visSelStart >= 0 && li === visSelStart) {
      const blockLines = visSelEnd - visSelStart;
      const blockTop = top + headerSpace + (visSelStart - startLine) * LINE_HEIGHT - 14;
      const blockHeight = blockLines * LINE_HEIGHT + 4;
      sceneCtx.fillStyle = 'rgba(111, 168, 220, 0.35)';
      sceneCtx.fillRect(left + 14, blockTop, width - 28, blockHeight);
    }
    // choose style for this line based on message read state
    const msg = messages[entry.msgIndex];
    const isSelMsg = selected && entry.msgIndex === messages.findIndex(m => m && m.id === selected.id);
    sceneCtx.fillStyle = isSelMsg ? '#fff' : (msg.read ? '#cfd8dc' : '#9be6ff');
    sceneCtx.fillText(entry.text, left + 20, y);
    y += LINE_HEIGHT;
    // add a small gap after the end of a message block to separate messages
    const nextEntry = (li + 1 < linesArray.length) ? linesArray[li + 1] : null;
    if (!nextEntry || nextEntry.msgIndex !== entry.msgIndex) {
      y += 6; // gap between messages
    }
  }
}

function renderFriendPanel() {
