function pushCanvasNotice(text, isError = false) {
  if (!text) {
    return;
  }
  canvasNotices.push({
    text: String(text),
    isError,
    expiresAt: Date.now() + NOTICE_DURATION_MS
  });
  if (canvasNotices.length > 6) {
    canvasNotices.shift();
  }
}

function renderCanvasNotices() {
  const now = Date.now();
  while (canvasNotices.length && canvasNotices[0].expiresAt <= now) {
    canvasNotices.shift();
  }
  if (!canvasNotices.length) {
    return;
  }

  sceneCtx.font = '14px "Microsoft YaHei", "PingFang SC", sans-serif';
  // Support multi-line notices and avoid overlapping by computing each
  // notice height based on wrapped lines.
  const maxWidth = Math.min(440, gameCanvas.width - 24);
  const LINE_HEIGHT = 18;
  let curTop = 16;
  for (let i = 0; i < canvasNotices.length; i += 1) {
    const notice = canvasNotices[i];
    const paddingH = 20;
    const paddingV = 8;
    const lines = wrapTextToLines(notice.text, maxWidth - paddingH);
    const textWidth = lines.reduce((acc, l) => Math.max(acc, sceneCtx.measureText(l).width), 0);
    const width = Math.min(maxWidth, Math.max(textWidth + paddingH, 80));
    const left = Math.round((gameCanvas.width - width) / 2);
    const height = lines.length * LINE_HEIGHT + paddingV * 2;

    sceneCtx.fillStyle = notice.isError ? 'rgba(183, 28, 28, 0.86)' : 'rgba(19, 38, 57, 0.88)';
    sceneCtx.fillRect(left, curTop, width, height);
    sceneCtx.fillStyle = notice.isError ? '#ffebee' : '#c8f2ff';
    for (let li = 0; li < lines.length; li += 1) {
      sceneCtx.fillText(lines[li], left + 10, curTop + paddingV + (li + 1) * LINE_HEIGHT - 4);
    }

    curTop += height + 6;
  }
}

