function renderInventoryHUD() {
  if (!isJoined) return;
  const right = gameCanvas.width - 14;
  const top = 12;
  const width = 220;
  const height = INVENTORY_VISIBLE_ROWS * 22 + 16;
  const left = right - width;
  drawOverlayPanel(left, top, width, height);
  sceneCtx.fillStyle = '#fff';
  sceneCtx.font = '14px "Microsoft YaHei", "PingFang SC", sans-serif';
  sceneCtx.fillText('Inventory', left + 12, top + 20);

  const visible = INVENTORY_VISIBLE_ROWS;
  inventoryIndex = clamp(inventoryIndex, 0, Math.max(0, inventoryList.length - 1));
  inventoryScrollOffset = ensureIndexVisible(inventoryIndex, visible, inventoryList.length, inventoryScrollOffset);
  const start = inventoryScrollOffset;
  const end = Math.min(inventoryList.length, start + visible);

  for (let i = start; i < end; i += 1) {
    const item = inventoryList[i];
    const y = top + 40 + (i - start) * 22;
    const isSelected = i === inventoryIndex;
    if (isSelected) {
      sceneCtx.fillStyle = 'rgba(111, 168, 220, 0.35)';
      sceneCtx.fillRect(left + 10, y - 14, width - 20, 20);
    }
    // try to draw item icon (lazy load if needed)
    const icon = textures.itemIcons[item.id];
    let textX = left + 14;
    if (icon === undefined) {
      // start async load but don't block rendering
      (async id => {
        try {
          const img = await loadImage(`/textures/${id}.png`);
          if (img) {
            textures.itemIcons[id] = img;
            return;
          }
          const img2 = await loadImage(`/textures/item-${id}.png`);
          textures.itemIcons[id] = img2 || null;
        } catch (_e) {
          textures.itemIcons[id] = null;
        }
      })(item.id);
    }
    if (icon) {
      // draw icon then shift text to the right
      sceneCtx.drawImage(icon, left + 12, y - 12, 16, 16);
      textX = left + 34;
    }
    sceneCtx.fillStyle = isSelected ? '#fff' : '#cfd8dc';
    const label = `${item.name || item.id} x${item.qty}`;
    sceneCtx.fillText(`${isSelected ? '> ' : '  '}${label}`, textX, y);
  }
}

