  const left = Math.round((gameCanvas.width - width) / 2);
  const top = Math.round((gameCanvas.height - height) / 2);
  drawOverlayPanel(left, top, width, height);

  const candidates = getFriendPanelCandidates();
  friendPanelIndex = clamp(friendPanelIndex, 0, Math.max(0, candidates.length - 1));
  const selected = candidates[friendPanelIndex] || null;

  sceneCtx.fillStyle = '#fff';
  sceneCtx.font = '16px "Microsoft YaHei", "PingFang SC", sans-serif';
  sceneCtx.fillText('Friends', left + 16, top + 28);
  sceneCtx.font = '13px "Microsoft YaHei", "PingFang SC", sans-serif';
  sceneCtx.fillStyle = '#cfd8dc';
  sceneCtx.fillText('↑/↓ Select  Mouse Wheel Scroll  Enter Add Friend  B Block/Unblock  N Input Name  Esc Close', left + 16, top + height - 18);

  if (!candidates.length) {
    sceneCtx.fillStyle = '#b0bec5';
    sceneCtx.fillText('No friends or players available.', left + 16, top + 70);
  }

  const visibleRows = 8;
  friendPanelScrollOffset = ensureIndexVisible(friendPanelIndex, visibleRows, candidates.length, friendPanelScrollOffset);
  const start = friendPanelScrollOffset;
  const end = Math.min(candidates.length, start + visibleRows);

  // Render each candidate, supporting wrapped / multi-line names/status
  const LINE_HEIGHT = 20;
  let curY = top + 64;
  for (let i = start; i < end; i += 1) {
    const user = candidates[i];
    const isSelected = selected && selected.id === user.id;
    const isFriend = user.kind === 'friend';
    const status = user.kind === 'friend'
      ? user.online
        ? user.blocked
          ? ' (friend, online, blocked)'
          : ' (friend, online)'
        : user.blocked
          ? ' (friend, offline, blocked)'
          : ' (friend, offline)'
      : ' (player)';
    const text = `${isSelected ? '> ' : '  '}${user.name}${status}`;

    const maxTextWidth = width - 44; // left padding + right padding
    const lines = wrapTextToLines(text, maxTextWidth);
    const itemHeight = lines.length * LINE_HEIGHT;

    if (isSelected) {
      sceneCtx.fillStyle = 'rgba(111, 168, 220, 0.35)';
      sceneCtx.fillRect(left + 14, curY - 14, width - 28, itemHeight + 4);
    }

    sceneCtx.fillStyle = isSelected ? '#fff' : '#cfd8dc';
    for (let k = 0; k < lines.length; k += 1) {
      sceneCtx.fillText(lines[k], left + 20, curY + k * LINE_HEIGHT);
    }

    curY += itemHeight + 4;
  }
}

