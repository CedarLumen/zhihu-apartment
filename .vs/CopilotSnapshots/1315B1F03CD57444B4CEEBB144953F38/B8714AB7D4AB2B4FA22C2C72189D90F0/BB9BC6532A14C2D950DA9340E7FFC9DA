  return 'none';
}

function getRoomGeometry() {
  const width = ROOM_WIDTH_TILES * TILE_SIZE;
  const height = ROOM_HEIGHT_TILES * TILE_SIZE;
  const left = Math.round((gameCanvas.width - width) / 2);
  const top = ROOM_TOP_Y;
  const floorY = top + (ROOM_HEIGHT_TILES - 1) * TILE_SIZE;
  return { width, height, left, top, floorY };
}

function getInteractables(mode = getSceneMode()) {
  if (!sceneState || !layout) {
    return [];
  }

  if (mode === 'corridor') {
    const owners = new Map((sceneState.floorDirectory || []).map(x => [x.doorplate, x.ownerName]));
    const interactables = [];
    for (let doorplate = 1; doorplate <= layout.residentCapacity; doorplate += 1) {
      interactables.push({
        type: 'room',
        x: getDoorX(doorplate),
        roomId: `room-${doorplate}`,
        doorplate,
        ownerName: owners.get(doorplate) || 'Empty'
      });
    }

    const stairsOffset = Number(layout.stairsOffsetX) || STAIRS_OFFSET_X;
    const communityOffset = Number(layout.communitySpaceOffsetX) || COMMUNITY_SPACE_OFFSET_X;
    const stairsX = getDoorX(layout.residentCapacity) + stairsOffset;
    const communityRoomId = layout.communitySpaceRoomId || COMMUNITY_SPACE_ROOM_ID;

    interactables.push({
      type: 'stairs',
      x: stairsX,
      roomId: null,
      doorplate: null,
      ownerName: STAIRS_LABEL
    });

    interactables.push({
      type: 'community',
      x: getDoorX(layout.residentCapacity) + communityOffset,
      roomId: communityRoomId,
      doorplate: null,
      ownerName: COMMUNITY_SPACE_LABEL
    });

    // place an agent near the community space
    // NPC agent removed from floor corridors; agent is only shown in lobby-1

    return interactables;
  }

  if (mode === 'lobby') {
    const items = [{ type: 'stairs', x: Math.round(gameCanvas.width / 2), ownerName: STAIRS_LABEL }];
    // place NPC agent in lobby-1 (visual only, no room)
    try {
      if (sceneState?.areaId === 'lobby-1') {
        items.unshift({ type: 'agent', x: Math.round(gameCanvas.width / 2) - 40, roomId: null, doorplate: null, agentId: 'liu-kanshan', ownerName: '刘看山' });
      }
    } catch (_e) {}
    return items;
  }

  if (mode === 'room') {
    const room = getRoomGeometry();
    return [{ type: 'exit', x: room.left + 54, ownerName: EXIT_LABEL, roomId: 'corridor' }];
  }

  return [];
}

function getNearestInteractable(interactables) {
  let nearest = null;
  let minDistance = Number.POSITIVE_INFINITY;

  for (const item of interactables) {
    const distance = Math.abs(player.x - item.x);
    if (distance < minDistance) {
      minDistance = distance;
      nearest = item;
    }
  }

  if (minDistance > INTERACT_DISTANCE) {
    return null;
  }
  return nearest;
}

function describeInteractable(item) {
  if (!item) {
    return `Move with A/D or \u2190/\u2192, jump with W/\u2191/Space, chat with ${CHAT_OPEN_KEY}. Press E near a door or staircase, ${CLEAR_HISTORY_KEY} to clear history.`;
  }
  if (item.type === 'stairs') {
    return `Press E: Enter ${STAIRS_LABEL}. Press ${CHAT_OPEN_KEY} to chat, ${CLEAR_HISTORY_KEY} to clear history.`;
  }
  if (item.type === 'community') {
    return `Press E: Enter ${COMMUNITY_SPACE_LABEL}. Press ${CHAT_OPEN_KEY} to chat, ${CLEAR_HISTORY_KEY} to clear history.`;
  }
  if (item.type === 'agent') {
    return `Press E: Chat with ${item.ownerName}. Press ${CHAT_OPEN_KEY} to chat, ${CLEAR_HISTORY_KEY} to clear history.`;
  }
  if (item.type === 'exit') {
    return `Press E: Use ${EXIT_LABEL} to return corridor`;
  }
  return `Press E: Enter room ${item.doorplate} (${item.ownerName}). Press ${CLAIM_KEY} to claim/move, ${CLEAR_HISTORY_KEY} to clear history.`;
}

