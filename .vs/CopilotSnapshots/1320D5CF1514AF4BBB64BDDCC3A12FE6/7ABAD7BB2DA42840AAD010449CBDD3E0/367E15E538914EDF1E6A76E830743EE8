function getJoinFields() {
  const fields = [
    { key: 'name', label: 'User Name', type: 'text' },
    { key: 'role', label: 'User Role', type: 'select' }
  ];
  if (joinUi.role === 'resident') {
    fields.push({ key: 'homeFloor', label: 'Resident Floor', type: 'select' });
    fields.push({ key: 'doorplate', label: 'Doorplate', type: 'select' });
  }
  fields.push({ key: 'areaId', label: 'Start Area', type: 'select' });
  fields.push({ key: 'restoreHistory', label: 'Restore 30 days history', type: 'checkbox' });
  fields.push({ key: 'join', label: 'Join', type: 'button' });
  return fields;
}

function clampJoinFocus() {
  const fields = getJoinFields();
  joinUi.focusIndex = clamp(joinUi.focusIndex, 0, fields.length - 1);
}

function cycleJoinValue(fieldKey, delta) {
  if (fieldKey === 'role') {
    joinUi.role = joinUi.role === 'visitor' ? 'resident' : 'visitor';
    clampJoinFocus();
    return;
  }
  if (fieldKey === 'homeFloor' && layout?.floors?.length) {
    const index = layout.floors.indexOf(joinUi.homeFloor);
    const next = (index + delta + layout.floors.length) % layout.floors.length;
    joinUi.homeFloor = layout.floors[next];
    return;
  }
  if (fieldKey === 'doorplate' && layout?.residentCapacity) {
    const max = layout.residentCapacity;
    const value = ((joinUi.doorplate - 1 + delta + max) % max) + 1;
    joinUi.doorplate = value;
    return;
  }
  if (fieldKey === 'areaId') {
    const options = getAreaOptions();
    if (!options.length) {
      return;
    }
    const index = Math.max(0, options.findIndex(x => x.value === joinUi.areaId));
    const next = (index + delta + options.length) % options.length;
    joinUi.areaId = options[next].value;
  }
}

function joinFromCanvas() {
  nameInput.value = joinUi.name;
  roleSelect.value = joinUi.role;
  homeFloorSelect.value = String(joinUi.homeFloor);
  doorplateSelect.value = String(joinUi.doorplate);
