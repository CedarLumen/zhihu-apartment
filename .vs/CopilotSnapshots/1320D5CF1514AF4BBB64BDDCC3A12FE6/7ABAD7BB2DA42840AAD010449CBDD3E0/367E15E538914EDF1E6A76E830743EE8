function renderHistory(history) {
  messages.innerHTML = '';
  chatLog.length = 0;
  history.forEach(m => {
    addMessage(m.sender, m.text, m.sender === 'System');
  });
}

function updateChatImeInput() {
  if (!imeChatInput) {
    return;
  }

  if (!isJoined) {
    imeChatInput.classList.add('hidden');
    imeChatInput.blur();
    return;
  }

  imeChatInput.classList.toggle('hidden', !isChatPanelOpen);

  if (!isChatComposing && imeChatInput.value !== chatInputText) {
    imeChatInput.value = chatInputText;
  }

  if (isChatPanelOpen && document.activeElement !== imeChatInput) {
    imeChatInput.focus();
    imeChatInput.setSelectionRange(imeChatInput.value.length, imeChatInput.value.length);
  }
  if (!isChatPanelOpen && document.activeElement === imeChatInput) {
    imeChatInput.blur();
  }
}

function addMessage(sender, text, isSystem = false) {
  const item = document.createElement('div');
  item.className = `msg ${isSystem ? 'sys' : ''}`;
  item.textContent = `${sender}: ${text}`;
  messages.appendChild(item);
  messages.scrollTop = messages.scrollHeight;

  chatLog.push({ sender, text, isSystem });
  if (chatLog.length > 120) {
    chatLog.shift();
  }
}

function areaName(areaId) {
  if (areaId === 'lobby-1') return 'Lobby 1';
  if (areaId === 'lobby-2') return 'Lobby 2';
  if (areaId.startsWith('floor-')) return `Floor ${areaId.split('-')[1]}`;
  return areaId;
}

function roomName(roomId) {
  if (roomId === 'main') return 'Lobby';
  if (roomId === 'corridor') return 'Corridor';
  if (roomId.startsWith('room-')) return `Doorplate ${roomId.split('-')[1]} Room`;
  return roomId;
}

