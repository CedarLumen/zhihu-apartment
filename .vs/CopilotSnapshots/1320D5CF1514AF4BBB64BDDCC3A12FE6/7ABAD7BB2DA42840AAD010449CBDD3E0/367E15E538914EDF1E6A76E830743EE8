function handleUiButtonClick(key) {
  if (key === 'chat') {
    isChatPanelOpen = !isChatPanelOpen;
    if (isChatPanelOpen) {
      closeStairsMenu();
      closeRoomSettings();
      stopMovement();
    }
    updateChatImeInput();
    return;
  }
  if (key === 'claim') {
    handleClaimNearestRoom();
    return;
  }
  if (key === 'settings') {
    if (isRoomSettingsOpen) {
      closeRoomSettings();
    } else {
      openRoomSettings();
    }
  }
}

