    sceneCtx.fillText(`${line.sender}: ${line.text}`, left + 14, top + 52 + idx * 20);
  });

  sceneCtx.fillStyle = '#263238';
  sceneCtx.fillRect(left + 12, top + height - 44, width - 24, 28);
  sceneCtx.strokeStyle = '#6fa8dc';
  sceneCtx.strokeRect(left + 12, top + height - 44, width - 24, 28);
  sceneCtx.fillStyle = '#fff';
  sceneCtx.fillText(`> ${chatInputText}`, left + 18, top + height - 24);
}

function getOtherPlayers(mode = getSceneMode()) {
  if (!sceneState?.roomUsers?.length) {
    return [];
  }

  const others = sceneState.roomUsers.filter(u => u.id !== currentUserId);
  if (!others.length) {
    return [];
  }
  const groundY = mode === 'room' ? getRoomGeometry().floorY : FLOOR_Y;
  const interactables = getInteractables(mode);
  const fallbackMinX = interactables.length ? (mode === 'lobby' ? interactables[0].x - 150 : interactables[0].x - 40) : 40;
  const fallbackMaxX = interactables.length
    ? (mode === 'lobby' ? interactables[0].x + 150 : interactables[interactables.length - 1].x + 40)
    : gameCanvas.width - 40;

  return others.map((u, i) => {
    const fallbackX = clamp(fallbackMinX + 50 + i * 56, fallbackMinX + 24, fallbackMaxX - 24);
    return {
      id: u.id,
      name: u.name,
      x: Number.isFinite(u.posX) ? u.posX : fallbackX,
      y: Number.isFinite(u.posY) ? Math.min(u.posY, groundY) : groundY
    };
  });
}

function renderScene() {
  sceneCtx.fillStyle = '#000';
  sceneCtx.fillRect(0, 0, gameCanvas.width, gameCanvas.height);

  const mode = getSceneMode();
  if (mode === 'none') {
    sceneHint.textContent = 'Move with A/D or \u2190/\u2192, jump with W/\u2191/Space. Press E to interact, T to chat.';
    sceneCtx.fillStyle = '#fff';
    sceneCtx.font = '16px "Microsoft YaHei", "PingFang SC", sans-serif';
    sceneCtx.fillText('Graphical scene is loading...', 20, 32);
    renderStairsMenu();
    renderChatPanel();
    return;
  }

  const interactables = getInteractables(mode);
  const nearest = getNearestInteractable(interactables);
  const otherPlayers = getOtherPlayers(mode);
  sceneHint.textContent = describeInteractable(nearest);

  if (mode === 'corridor' || mode === 'lobby') {
    const worldMaxX = interactables[interactables.length - 1].x + 80;
    const worldWidth = Math.max(gameCanvas.width, worldMaxX + 80);
    const cameraX = clamp(player.x - gameCanvas.width / 2, 0, worldWidth - gameCanvas.width);
    const tileStart = Math.floor((cameraX - TILE_SIZE) / TILE_SIZE);
    const tileEnd = Math.ceil((cameraX + gameCanvas.width + TILE_SIZE) / TILE_SIZE);

    for (let i = tileStart; i <= tileEnd; i += 1) {
      const drawX = i * TILE_SIZE - cameraX;
      drawSprite(textures.wallpaperUpper, drawX, FLOOR_Y - 96, TILE_SIZE, TILE_SIZE, '#111');
      drawSprite(textures.wallpaperMiddle, drawX, FLOOR_Y - 64, TILE_SIZE, TILE_SIZE, '#1a1a1a');
      drawSprite(textures.wallpaperMiddle, drawX, FLOOR_Y - 32, TILE_SIZE, TILE_SIZE, '#1a1a1a');
      drawSprite(textures.wallpaperLower, drawX, FLOOR_Y, TILE_SIZE, TILE_SIZE, '#242424');
      drawSprite(textures.floor, drawX, FLOOR_Y, TILE_SIZE, TILE_SIZE, '#464646');
    }

    for (const item of interactables) {
      const drawX = item.x - cameraX - DOOR_WIDTH / 2;
      drawSprite(textures.door, drawX, FLOOR_Y - (DOOR_HEIGHT - TILE_SIZE), DOOR_WIDTH, DOOR_HEIGHT, '#6b4a2d');
      if (item.type === 'stairs') {
        drawDoorLabel(STAIRS_LABEL, item.x - cameraX, FLOOR_Y - 42);
      } else {
        drawDoorLabel(`${item.doorplate}: ${item.ownerName}`, item.x - cameraX, FLOOR_Y - 42);
      }
    }

    if (nearest) {
      const drawX = nearest.x - cameraX - DOOR_WIDTH / 2;
      sceneCtx.strokeStyle = '#ffd54f';
      sceneCtx.lineWidth = 2;
      sceneCtx.strokeRect(drawX - 2, FLOOR_Y - (DOOR_HEIGHT - TILE_SIZE) - 2, DOOR_WIDTH + 4, DOOR_HEIGHT + 4);
    }

    for (const other of otherPlayers) {
      drawSprite(textures.playerImage, other.x - cameraX - 16, other.y, 32, 32, '#6dc56d');
      drawPlayerName(other.name, other.x - cameraX, other.y - 6);
    }

    drawSprite(textures.playerImage, player.x - cameraX - 16, player.y, 32, 32, '#4ea7ff');
    drawPlayerName('You', player.x - cameraX, player.y - 6);
    renderStairsMenu();
    renderChatPanel();
    return;
  }

  if (mode === 'room') {
    const room = getRoomGeometry();
    for (let i = 0; i < ROOM_WIDTH_TILES; i += 1) {
      const drawX = room.left + i * TILE_SIZE;
      drawSprite(textures.wallpaperUpper, drawX, room.top, TILE_SIZE, TILE_SIZE, '#111');
      drawSprite(textures.wallpaperMiddle, drawX, room.top + TILE_SIZE, TILE_SIZE, TILE_SIZE, '#1a1a1a');
      drawSprite(textures.wallpaperMiddle, drawX, room.top + TILE_SIZE * 2, TILE_SIZE, TILE_SIZE, '#1a1a1a');
      drawSprite(textures.wallpaperMiddle, drawX, room.top + TILE_SIZE * 3, TILE_SIZE, TILE_SIZE, '#1a1a1a');
      drawSprite(textures.wallpaperLower, drawX, room.floorY, TILE_SIZE, TILE_SIZE, '#242424');
      drawSprite(textures.floor, drawX, room.floorY, TILE_SIZE, TILE_SIZE, '#464646');
    }

    const exit = interactables[0];
    const doorX = exit.x - DOOR_WIDTH / 2;
    drawSprite(textures.door, doorX, room.floorY - (DOOR_HEIGHT - TILE_SIZE), DOOR_WIDTH, DOOR_HEIGHT, '#6b4a2d');
    drawDoorLabel(EXIT_LABEL, exit.x, room.floorY - 42);

    if (nearest?.type === 'exit') {
      sceneCtx.strokeStyle = '#ffd54f';
      sceneCtx.lineWidth = 2;
      sceneCtx.strokeRect(doorX - 2, room.floorY - (DOOR_HEIGHT - TILE_SIZE) - 2, DOOR_WIDTH + 4, DOOR_HEIGHT + 4);
    }

    for (const other of otherPlayers) {
      drawSprite(textures.playerImage, other.x - 16, other.y, 32, 32, '#6dc56d');
      drawPlayerName(other.name, other.x, other.y - 6);
    }

    drawSprite(textures.playerImage, player.x - 16, player.y, 32, 32, '#4ea7ff');
    drawPlayerName('You', player.x, player.y - 6);
    renderStairsMenu();
    renderChatPanel();
  }
}

function getGroundY(mode = getSceneMode()) {
  if (mode === 'room') {
    return getRoomGeometry().floorY;
  }
  return FLOOR_Y;
}

function syncState(state) {
  const previousState = sceneState;
  sceneState = state;
  locationInfo.textContent = `Current area: ${areaName(state.areaId)} / ${roomName(state.roomId)}`;
  scenePanel.classList.remove('hidden');

  selfInfo.textContent = selfInfo.textContent.split(' | ')[0];
  if (state.ownedRoom) {
    const ownedLabel = `Owned room: Floor ${state.ownedRoom.floor}, ${roomName(state.ownedRoom.roomId)}`;
    selfInfo.textContent = `${selfInfo.textContent.split(' | ')[0]} | ${ownedLabel}`;
  }

  const mode = getSceneMode(state);
  const previousMode = getSceneMode(previousState);
  const roomMatch = /^room-(\d+)$/.exec(state.roomId || '');
  if (mode === 'corridor' && previousMode === 'room' && previousState?.areaId === state.areaId) {
    const previousRoomMatch = /^room-(\d+)$/.exec(previousState.roomId || '');
    if (previousRoomMatch) {
      player.x = getDoorX(Number(previousRoomMatch[1]));
    }
  } else if (mode === 'corridor' && roomMatch) {
    player.x = getDoorX(Number(roomMatch[1]));
  } else if (mode === 'corridor') {
    player.x = getDoorX(layout.residentCapacity) + 120;
  } else if (mode === 'lobby') {
    player.x = Math.round(gameCanvas.width / 2);
  } else if (mode === 'room') {
    const room = getRoomGeometry();
    player.x = room.left + 110;
  }

  player.y = getGroundY(mode);
  player.velocityX = 0;
  player.velocityY = 0;
  player.jumpRequested = false;
  lastSentX = null;
  lastSentY = null;
  closeStairsMenu();

  usersList.innerHTML = '';
  state.roomUsers.forEach(u => {
    const li = document.createElement('li');
    if (u.role === 'resident') {
      li.textContent = `${u.name} (resident floor ${u.homeFloor}, doorplate ${u.doorplate})`;
    } else {
      li.textContent = `${u.name} (visitor)`;
    }
    usersList.appendChild(li);
  });
}

function updatePlayerPosition(dt) {
  if (!sceneState || !layout) {
    return;
  }

  const mode = getSceneMode();
  const interactables = getInteractables(mode);
  if (!interactables.length) {
    return;
  }

  let minX;
  let maxX;
  if (mode === 'room') {
    const room = getRoomGeometry();
    minX = room.left + 24;
    maxX = room.left + room.width - 24;
  } else if (mode === 'lobby') {
    minX = interactables[0].x - 150;
    maxX = interactables[0].x + 150;
  } else {
    minX = interactables[0].x - 40;
    maxX = interactables[interactables.length - 1].x + 40;
  }

  const groundY = getGroundY(mode);
  const isOnGround = player.y >= groundY - 0.5;
  const direction = (player.moveRight ? 1 : 0) - (player.moveLeft ? 1 : 0);
  const drag = isOnGround ? PLAYER_GROUND_DRAG : PLAYER_AIR_DRAG;

  player.velocityX += direction * PLAYER_ACCELERATION * dt;
  player.velocityX -= player.velocityX * drag * dt;
  player.velocityX = clamp(player.velocityX, -PLAYER_SPEED, PLAYER_SPEED);
  if (direction === 0 && Math.abs(player.velocityX) < 3) {
    player.velocityX = 0;
  }

  player.x = clamp(player.x + player.velocityX * dt, minX, maxX);
  if ((player.x <= minX && player.velocityX < 0) || (player.x >= maxX && player.velocityX > 0)) {
    player.velocityX = 0;
  }

  if (player.jumpRequested && isOnGround) {
    player.velocityY = PLAYER_JUMP_VELOCITY;
  }
  player.jumpRequested = false;

  player.velocityY += PLAYER_GRAVITY * dt;
  player.y += player.velocityY * dt;
  if (player.y > groundY) {
    player.y = groundY;
    player.velocityY = 0;
  }
}

function syncPlayerPosition(timestamp) {
  if (!sceneState || !canSyncPlayerPosition || isStairsMenuOpen || isChatPanelOpen) {
    return;
  }

  const now = timestamp || performance.now();
  if (now - lastSentPositionAt < POSITION_SYNC_INTERVAL_MS) {
    return;
  }

  const x = Math.round(player.x * 100) / 100;
  const y = Math.round(player.y * 100) / 100;
  if (lastSentX === x && lastSentY === y) {
    return;
  }

  lastSentPositionAt = now;
  lastSentX = x;
  lastSentY = y;
  send('player-move', { x, y });
}

function frame(timestamp) {
  const dt = Math.min(0.05, (timestamp - lastFrame) / 1000 || 0);
  lastFrame = timestamp;
  updatePlayerPosition(dt);
  syncPlayerPosition(timestamp);
  renderScene();
  requestAnimationFrame(frame);
}

async function init() {
  const res = await fetch('/api/layout');
  layout = await res.json();
  fillOptions();
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
  await loadTextures();
  requestAnimationFrame(frame);

  const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
  ws = new WebSocket(`${protocol}://${window.location.host}`);

  ws.onmessage = e => {
    const data = JSON.parse(e.data);
    if (data.type === 'error') {
      if (data.payload?.message === 'Unknown command') {
        canSyncPlayerPosition = false;
        return;
      }
      alert(data.payload.message);
      return;
    }
    if (data.type === 'chat') {
      addMessage(data.payload.sender, data.payload.text, data.payload.sender === 'System');
      return;
    }
    if (data.type === 'chat-history') {
      renderHistory(data.payload.messages || []);
      return;
    }
    if (data.type === 'info') {
      alert(data.payload.message);
      return;
    }
    if (data.type === 'joined') {
      const me = data.payload;
      currentUserId = me.id;
      selfInfo.textContent = me.role === 'resident'
        ? `User: ${me.name} (resident floor ${me.homeFloor}, doorplate ${me.doorplate})`
        : `User: ${me.name} (visitor)`;
      joinPanel.classList.add('hidden');
      chatPanel.classList.remove('hidden');
      return;
    }
    if (data.type === 'state') {
      syncState(data.payload);
      return;
    }
    if (data.type === 'room-users') {
      if (sceneState) {
        sceneState.roomUsers = data.payload?.roomUsers || [];
      }
    }
  };

  roleSelect.addEventListener('change', () => {
    residentFields.classList.toggle('hidden', roleSelect.value !== 'resident');
  });

  joinBtn.addEventListener('click', () => {
    const payload = {
      name: nameInput.value,
      role: roleSelect.value,
      areaId: areaSelect.value,
      restoreHistory: restoreHistoryCheckbox.checked
    };
    if (roleSelect.value === 'resident') {
      payload.homeFloor = Number(homeFloorSelect.value);
      payload.doorplate = Number(doorplateSelect.value);
    }
    send('join', payload);
  });

  window.addEventListener('keydown', e => {
    if (isChatPanelOpen) {
      if (e.key === 'Escape') {
        isChatPanelOpen = false;
        stopMovement();
        e.preventDefault();
        return;
      }
      if (e.key === 'Enter') {
        const text = chatInputText.trim();
        if (text) {
          send('chat', { text });
          chatInputText = '';
        }
        e.preventDefault();
        return;
      }
      if (e.key === 'Backspace') {
        chatInputText = chatInputText.slice(0, -1);
        e.preventDefault();
        return;
      }
      if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
        chatInputText += e.key;
        e.preventDefault();
      }
      return;
    }

    if (isStairsMenuOpen) {
      if (e.key === 'Escape') {
        closeStairsMenu();
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') {
        stairsMenuIndex = (stairsMenuIndex - 1 + stairsMenuOptions.length) % stairsMenuOptions.length;
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') {
        stairsMenuIndex = (stairsMenuIndex + 1) % stairsMenuOptions.length;
        e.preventDefault();
        return;
      }
      if (e.key === 'Enter' || e.key === 'e' || e.key === 'E') {
        const selected = stairsMenuOptions[stairsMenuIndex];
        if (selected && selected.areaId !== sceneState?.areaId) {
          send('switch-area', { areaId: selected.areaId });
        }
        closeStairsMenu();
        e.preventDefault();
      }
      return;
    }

    if ((e.key === 't' || e.key === 'T') && !e.repeat) {
      isChatPanelOpen = true;
      chatInputText = '';
      stopMovement();
      e.preventDefault();
      return;
    }

    if ((e.key === 'r' || e.key === 'R') && !e.repeat) {
      handleClaimNearestRoom();
      e.preventDefault();
      return;
    }

    if ((e.key === 'h' || e.key === 'H') && !e.repeat) {
      send('clear-history', {});
      e.preventDefault();
      return;
    }

    if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') {
      player.moveLeft = true;
      e.preventDefault();
      return;
    }
    if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') {
      player.moveRight = true;
      e.preventDefault();
      return;
    }
    if ((e.key === 'e' || e.key === 'E') && !e.repeat) {
      handleInteract();
      e.preventDefault();
      return;
    }
    if ((e.key === 'w' || e.key === 'W' || e.key === 'ArrowUp' || e.code === 'Space') && !e.repeat) {
      player.jumpRequested = true;
      e.preventDefault();
      return;
    }
  });

  window.addEventListener('keyup', e => {
    if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') {
      player.moveLeft = false;
      return;
    }
    if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') {
      player.moveRight = false;
    }
  });
}

init();
