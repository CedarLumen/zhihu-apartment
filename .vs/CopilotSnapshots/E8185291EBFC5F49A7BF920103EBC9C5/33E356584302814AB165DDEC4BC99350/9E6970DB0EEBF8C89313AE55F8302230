function playSound(soundName) {
  const sound = sounds[soundName];
  if (!sound) {
    return;
  }
  sound.currentTime = 0;
  sound.play().catch(() => {});
}

function clamp(value, min, max) {
  return Math.max(min, Math.min(max, value));
}

function getDoorX(doorplate) {
  return DOOR_START_X + (doorplate - 1) * DOOR_SPACING;
}

function getSceneMode(targetState = sceneState) {
  if (!targetState) {
    return 'none';
  }
  if (targetState.areaType === 'lobby') {
    return 'lobby';
  }
  if (targetState.areaType === 'floor' && targetState.roomId === 'corridor') {
    return 'corridor';
  }
  if (targetState.areaType === 'floor' && /^room-\d+$/.test(targetState.roomId || '')) {
    return 'room';
  }
  return 'none';
}

function getRoomGeometry() {
  const width = ROOM_WIDTH_TILES * TILE_SIZE;
  const height = ROOM_HEIGHT_TILES * TILE_SIZE;
  const left = Math.round((gameCanvas.width - width) / 2);
  const top = ROOM_TOP_Y;
  const floorY = top + (ROOM_HEIGHT_TILES - 1) * TILE_SIZE;
  return { width, height, left, top, floorY };
}

function getInteractables(mode = getSceneMode()) {
  if (!sceneState || !layout) {
    return [];
  }

  if (mode === 'corridor') {
    const owners = new Map((sceneState.floorDirectory || []).map(x => [x.doorplate, x.ownerName]));
    const interactables = [];
    for (let doorplate = 1; doorplate <= layout.residentCapacity; doorplate += 1) {
      interactables.push({
        type: 'room',
        x: getDoorX(doorplate),
        roomId: `room-${doorplate}`,
        doorplate,
        ownerName: owners.get(doorplate) || 'Empty'
      });
    }

    interactables.push({
      type: 'stairs',
      x: getDoorX(layout.residentCapacity) + 120,
      roomId: null,
      doorplate: null,
      ownerName: STAIRS_LABEL
    });

    return interactables;
  }

  if (mode === 'lobby') {
    return [{ type: 'stairs', x: Math.round(gameCanvas.width / 2), ownerName: STAIRS_LABEL }];
  }

  if (mode === 'room') {
    const room = getRoomGeometry();
    return [{ type: 'exit', x: room.left + 54, ownerName: EXIT_LABEL, roomId: 'corridor' }];
  }

  return [];
}

function getNearestInteractable(interactables) {
  let nearest = null;
  let minDistance = Number.POSITIVE_INFINITY;

  for (const item of interactables) {
    const distance = Math.abs(player.x - item.x);
    if (distance < minDistance) {
      minDistance = distance;
      nearest = item;
    }
  }

  if (minDistance > INTERACT_DISTANCE) {
    return null;
  }
  return nearest;
}

function describeInteractable(item) {
  if (!item) {
    return `Move with A/D or \u2190/\u2192, jump with W/\u2191/Space, chat with ${CHAT_OPEN_KEY}. Press E near a door or staircase, ${CLEAR_HISTORY_KEY} to clear history.`;
  }
  if (item.type === 'stairs') {
    return `Press E: Enter ${STAIRS_LABEL}. Press ${CHAT_OPEN_KEY} to chat, ${CLEAR_HISTORY_KEY} to clear history.`;
  }
  if (item.type === 'exit') {
    return `Press E: Use ${EXIT_LABEL} to return corridor`;
  }
  return `Press E: Enter room ${item.doorplate} (${item.ownerName}). Press ${CLAIM_KEY} to claim/move, ${CLEAR_HISTORY_KEY} to clear history.`;
}

function handleClaimNearestRoom() {
  if (!sceneState || getSceneMode() !== 'corridor') {
    return;
  }
  const nearest = getNearestInteractable(getInteractables('corridor'));
  if (!nearest || nearest.type !== 'room') {
    return;
  }
  send('claim-room', { doorplate: Number(nearest.doorplate) });
}

function resizeCanvas() {
  gameCanvas.width = Math.max(960, window.innerWidth);
  gameCanvas.height = Math.max(320, window.innerHeight);
}

function handleInteract() {
  if (!sceneState || !layout) {
    return;
  }

  const mode = getSceneMode();
  const nearest = getNearestInteractable(getInteractables(mode));

  if (mode === 'room') {
    if (nearest?.type === 'exit') {
      send('enter-room', { roomId: 'corridor' });
    }
    return;
  }

  if (!nearest) {
    return;
  }

  if (nearest.type === 'stairs') {
    openStairsMenu();
    return;
  }

  if (nearest.type === 'room') {
    send('enter-room', { roomId: nearest.roomId });
    return;
  }
}

function drawSprite(image, x, y, width, height, fallback) {
  if (image) {
    sceneCtx.drawImage(image, x, y, width, height);
    return;
  }
  sceneCtx.fillStyle = fallback;
  sceneCtx.fillRect(x, y, width, height);
}

function drawDoorLabel(text, x, y) {
  sceneCtx.font = '12px "Microsoft YaHei", "PingFang SC", sans-serif';
  const paddingX = 6;
  const width = sceneCtx.measureText(text).width + paddingX * 2;
  const left = Math.round(x - width / 2);
  sceneCtx.fillStyle = 'rgba(0, 0, 0, 0.85)';
  sceneCtx.fillRect(left, y - 14, width, 16);
  sceneCtx.fillStyle = '#fff';
  sceneCtx.fillText(text, left + paddingX, y - 2);
}

function drawPlayerName(text, x, y) {
  sceneCtx.font = '12px "Microsoft YaHei", "PingFang SC", sans-serif';
  const paddingX = 6;
  const width = sceneCtx.measureText(text).width + paddingX * 2;
  const left = Math.round(x - width / 2);
  sceneCtx.fillStyle = 'rgba(0, 0, 0, 0.85)';
  sceneCtx.fillRect(left, y - 14, width, 16);
  sceneCtx.fillStyle = '#9be6ff';
  sceneCtx.fillText(text, left + paddingX, y - 2);
}

function drawOverlayPanel(x, y, w, h) {
  sceneCtx.fillStyle = 'rgba(8, 12, 18, 0.9)';
  sceneCtx.fillRect(x, y, w, h);
  sceneCtx.strokeStyle = '#6fa8dc';
  sceneCtx.lineWidth = 2;
  sceneCtx.strokeRect(x, y, w, h);
}

function renderStairsMenu() {
  if (!isStairsMenuOpen) {
    return;
  }
  const width = 420;
  const height = 220;
  const left = Math.round((gameCanvas.width - width) / 2);
  const top = Math.round((gameCanvas.height - height) / 2);

  drawOverlayPanel(left, top, width, height);
  sceneCtx.fillStyle = '#fff';
  sceneCtx.font = '16px "Microsoft YaHei", "PingFang SC", sans-serif';
  sceneCtx.fillText('\u697c\u68af\u76ee\u7684\u5730\u9009\u62e9', left + 16, top + 30);

  sceneCtx.font = '14px "Microsoft YaHei", "PingFang SC", sans-serif';
  for (let i = 0; i < stairsMenuOptions.length; i += 1) {
    const itemTop = top + 52 + i * 24;
    const selected = i === stairsMenuIndex;
    if (selected) {
      sceneCtx.fillStyle = 'rgba(111, 168, 220, 0.35)';
      sceneCtx.fillRect(left + 14, itemTop - 14, width - 28, 20);
    }
    sceneCtx.fillStyle = selected ? '#fff' : '#cfd8dc';
    const prefix = selected ? '> ' : '  ';
    sceneCtx.fillText(`${prefix}${stairsMenuOptions[i].label}`, left + 20, itemTop);
  }

  sceneCtx.fillStyle = '#9be6ff';
  sceneCtx.fillText('\u2191/\u2193\u9009\u62e9  Enter\u786e\u8ba4  Esc\u53d6\u6d88', left + 16, top + height - 16);
}

function renderChatPanel() {
  if (!isChatPanelOpen) {
    return;
  }
  const width = 560;
  const height = 240;
  const left = Math.round((gameCanvas.width - width) / 2);
  const top = gameCanvas.height - height - 14;

  drawOverlayPanel(left, top, width, height);
  sceneCtx.fillStyle = '#fff';
  sceneCtx.font = '16px "Microsoft YaHei", "PingFang SC", sans-serif';
  sceneCtx.fillText('\u804a\u5929 (Esc: \u5173\u95ed, Enter: \u53d1\u9001)', left + 14, top + 26);

  const visible = chatLog.slice(-8);
