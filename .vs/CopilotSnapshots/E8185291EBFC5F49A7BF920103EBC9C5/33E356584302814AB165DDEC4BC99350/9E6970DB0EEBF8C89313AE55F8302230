}

function getAreaOptions() {
  if (!layout) {
    return [];
  }
  return [
    ...layout.lobbies.map(x => ({ value: x.id, label: `${x.name} (cap ${x.capacity})` })),
    ...layout.floors.map(x => ({
      value: `floor-${x}`,
      label: `Floor ${x} (resident ${layout.residentCapacity}/visitor ${layout.visitorCapacity})`
    }))
  ];
}

function getJoinFields() {
  const fields = [
    { key: 'name', label: 'User Name', type: 'text' },
    { key: 'role', label: 'User Role', type: 'select' }
  ];
  if (joinUi.role === 'resident') {
    fields.push({ key: 'homeFloor', label: 'Resident Floor', type: 'select' });
    fields.push({ key: 'doorplate', label: 'Doorplate', type: 'select' });
  }
  fields.push({ key: 'areaId', label: 'Start Area', type: 'select' });
  fields.push({ key: 'restoreHistory', label: 'Restore 30 days history', type: 'checkbox' });
  fields.push({ key: 'join', label: 'Join', type: 'button' });
  return fields;
}

function clampJoinFocus() {
  const fields = getJoinFields();
  joinUi.focusIndex = clamp(joinUi.focusIndex, 0, fields.length - 1);
}

function cycleJoinValue(fieldKey, delta) {
  if (fieldKey === 'role') {
    joinUi.role = joinUi.role === 'visitor' ? 'resident' : 'visitor';
    clampJoinFocus();
    return;
  }
  if (fieldKey === 'homeFloor' && layout?.floors?.length) {
    const index = layout.floors.indexOf(joinUi.homeFloor);
    const next = (index + delta + layout.floors.length) % layout.floors.length;
    joinUi.homeFloor = layout.floors[next];
    return;
  }
  if (fieldKey === 'doorplate' && layout?.residentCapacity) {
    const max = layout.residentCapacity;
    const value = ((joinUi.doorplate - 1 + delta + max) % max) + 1;
    joinUi.doorplate = value;
    return;
  }
  if (fieldKey === 'areaId') {
    const options = getAreaOptions();
    if (!options.length) {
      return;
    }
    const index = Math.max(0, options.findIndex(x => x.value === joinUi.areaId));
    const next = (index + delta + options.length) % options.length;
    joinUi.areaId = options[next].value;
  }
}

function joinFromCanvas() {
  const payload = {
    name: joinUi.name,
    role: joinUi.role,
    areaId: joinUi.areaId,
    restoreHistory: joinUi.restoreHistory
  };
  if (joinUi.role === 'resident') {
    payload.homeFloor = Number(joinUi.homeFloor);
    payload.doorplate = Number(joinUi.doorplate);
  }
  send('join', payload);
}

function stopMovement() {
  player.moveLeft = false;
  player.moveRight = false;
}

function openStairsMenu() {
  if (!sceneState || !layout) {
    return;
  }
  const mode = getSceneMode();
  if (mode !== 'corridor' && mode !== 'lobby') {
    return;
  }
  stairsMenuOptions = buildStairsMenuOptions();
  stairsMenuIndex = Math.max(0, stairsMenuOptions.findIndex(x => x.areaId === sceneState.areaId));
  isStairsMenuOpen = true;
  isChatPanelOpen = false;
  stopMovement();
}

function closeStairsMenu() {
  isStairsMenuOpen = false;
}

function send(type, payload) {
  if (!ws || ws.readyState !== 1) {
    return;
  }
  ws.send(JSON.stringify({ type, payload }));
}

function loadImage(src) {
  return new Promise(resolve => {
    const img = new Image();
    img.onload = () => resolve(img);
    img.onerror = () => resolve(null);
    img.src = src;
  });
}

function loadAudio(src) {
  return new Promise(resolve => {
    const audio = new Audio(src);
    audio.preload = 'auto';
    const done = () => resolve(audio);
    audio.addEventListener('canplaythrough', done, { once: true });
    audio.addEventListener('error', () => resolve(null), { once: true });
    audio.load();
    setTimeout(() => resolve(audio), 1200);
  });
}

