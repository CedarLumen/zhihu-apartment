const joinPanel = document.getElementById('joinPanel');
const chatPanel = document.getElementById('chatPanel');

const nameInput = document.getElementById('nameInput');
const roleSelect = document.getElementById('roleSelect');
const residentFields = document.getElementById('residentFields');
const homeFloorSelect = document.getElementById('homeFloorSelect');
const doorplateSelect = document.getElementById('doorplateSelect');
const areaSelect = document.getElementById('areaSelect');
const joinBtn = document.getElementById('joinBtn');

const selfInfo = document.getElementById('selfInfo');
const locationInfo = document.getElementById('locationInfo');
const switchAreaSelect = document.getElementById('switchAreaSelect');
const switchAreaBtn = document.getElementById('switchAreaBtn');
const roomPanel = document.getElementById('roomPanel');
const roomSelect = document.getElementById('roomSelect');
const enterRoomBtn = document.getElementById('enterRoomBtn');

const usersList = document.getElementById('usersList');
const messages = document.getElementById('messages');
const messageInput = document.getElementById('messageInput');
const sendBtn = document.getElementById('sendBtn');

const ZH = {
  title: '\u697c\u5c42\u804a\u5929\u7cfb\u7edf',
  nameLabel: '\u7528\u6237\u540d',
  roleLabel: '\u7528\u6237\u7c7b\u578b',
  visitor: '\u666e\u901a\u7528\u6237',
  resident: '\u5e38\u9a7b\u7528\u6237',
  homeFloorLabel: '\u5e38\u9a7b\u697c\u5c42',
  doorplateLabel: '\u95e8\u724c\u53f7 (1-10)',
  startAreaLabel: '\u521d\u59cb\u533a\u57df',
  joinBtn: '\u8fdb\u5165',
  switchAreaLabel: '\u5207\u6362\u533a\u57df',
  switchBtn: '\u5207\u6362',
  insideFloorLabel: '\u697c\u5c42\u5185\u4f4d\u7f6e',
  enterBtn: '\u8fdb\u5165',
  usersTitle: '\u540c\u623f\u95f4\u5728\u7ebf\u7528\u6237',
  chatTitle: '\u804a\u5929',
  msgPlaceholder: '\u8f93\u5165\u6d88\u606f',
  sendBtn: '\u53d1\u9001',
  lobby: '\u5927\u5385',
  floor: '\u697c\u5c42',
  corridor: '\u8d70\u5eca',
  room: '\u623f\u95f4',
  doorplate: '\u95e8\u724c',
  cap: '\u4e0a\u9650',
  residentShort: '\u5e38\u9a7b',
  visitorShort: '\u8bbf\u5ba2',
  currentArea: '\u5f53\u524d\u533a\u57df\uff1a',
  userPrefix: '\u7528\u6237\uff1a',
  floorMark: '\u5c42',
  system: '\u7cfb\u7edf'
};

let ws;
let layout;
let me;

function setUiText() {
  document.getElementById('titleText').textContent = ZH.title;
  document.getElementById('nameLabel').textContent = ZH.nameLabel;
  document.getElementById('roleLabel').textContent = ZH.roleLabel;
  document.getElementById('roleVisitorText').textContent = ZH.visitor;
  document.getElementById('roleResidentText').textContent = ZH.resident;
  document.getElementById('homeFloorLabel').textContent = ZH.homeFloorLabel;
  document.getElementById('doorplateLabel').textContent = ZH.doorplateLabel;
  document.getElementById('startAreaLabel').textContent = ZH.startAreaLabel;
  document.getElementById('switchAreaLabel').textContent = ZH.switchAreaLabel;
  document.getElementById('insideFloorLabel').textContent = ZH.insideFloorLabel;
  document.getElementById('roomUsersTitle').textContent = ZH.usersTitle;
  document.getElementById('chatTitle').textContent = ZH.chatTitle;

  joinBtn.textContent = ZH.joinBtn;
  switchAreaBtn.textContent = ZH.switchBtn;
  enterRoomBtn.textContent = ZH.enterBtn;
  sendBtn.textContent = ZH.sendBtn;
  messageInput.placeholder = ZH.msgPlaceholder;
}

function addMessage(sender, text, isSystem = false) {
  const item = document.createElement('div');
  item.className = `msg ${isSystem ? 'sys' : ''}`;
  item.textContent = `${sender}: ${text}`;
  messages.appendChild(item);
  messages.scrollTop = messages.scrollHeight;
}

function areaName(areaId) {
  if (areaId === 'lobby-1') return `${ZH.lobby} 1`;
  if (areaId === 'lobby-2') return `${ZH.lobby} 2`;
  if (areaId.startsWith('floor-')) return `${ZH.floor} ${areaId.split('-')[1]}`;
  return areaId;
}

function roomName(roomId) {
  if (roomId === 'main') return ZH.lobby;
  if (roomId === 'corridor') return ZH.corridor;
  if (roomId.startsWith('room-')) return `${ZH.doorplate} ${roomId.split('-')[1]} ${ZH.room}`;
  return roomId;
}

function fillOptions() {
  const areas = [
    ...layout.lobbies.map(x => ({ value: x.id, label: `${x.name} (${ZH.cap} ${x.capacity})` })),
    ...layout.floors.map(x => ({
      value: `floor-${x}`,
      label: `${ZH.floor} ${x} (${ZH.residentShort}${layout.residentCapacity}/${ZH.visitorShort}${layout.visitorCapacity})`
    }))
  ];

  [areaSelect, switchAreaSelect].forEach(select => {
    select.innerHTML = '';
    areas.forEach(item => {
      const option = document.createElement('option');
      option.value = item.value;
      option.textContent = item.label;
      select.appendChild(option);
    });
  });

  homeFloorSelect.innerHTML = '';
  layout.floors.forEach(x => {
    const option = document.createElement('option');
    option.value = String(x);
    option.textContent = `${ZH.floor} ${x}`;
    homeFloorSelect.appendChild(option);
  });

  doorplateSelect.innerHTML = '';
  for (let i = 1; i <= layout.residentCapacity; i += 1) {
    const option = document.createElement('option');
    option.value = String(i);
    option.textContent = String(i);
    doorplateSelect.appendChild(option);
  }

  roomSelect.innerHTML = '';
  const corridorOption = document.createElement('option');
  corridorOption.value = 'corridor';
  corridorOption.textContent = ZH.corridor;
  roomSelect.appendChild(corridorOption);

  for (let i = 1; i <= layout.residentCapacity; i += 1) {
    const option = document.createElement('option');
    option.value = `room-${i}`;
    option.textContent = `${ZH.doorplate} ${i} ${ZH.room}`;
    roomSelect.appendChild(option);
  }
}

function syncState(state) {
  locationInfo.textContent = `${ZH.currentArea} ${areaName(state.areaId)} / ${roomName(state.roomId)}`;
  roomPanel.classList.toggle('hidden', !state.canChooseRoom);

  usersList.innerHTML = '';
  state.roomUsers.forEach(u => {
    const li = document.createElement('li');
    if (u.role === 'resident') {
      li.textContent = `${u.name} (${ZH.residentShort}${u.homeFloor}${ZH.floorMark}, ${ZH.doorplate}${u.doorplate})`;
    } else {
      li.textContent = `${u.name} (${ZH.visitorShort})`;
    }
    usersList.appendChild(li);
  });
}

function send(type, payload) {
  ws.send(JSON.stringify({ type, payload }));
}

async function init() {
  setUiText();

  const res = await fetch('/api/layout');
  layout = await res.json();
  fillOptions();

  const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
  ws = new WebSocket(`${protocol}://${window.location.host}`);

  ws.onmessage = e => {
    const data = JSON.parse(e.data);
    if (data.type === 'error') {
      alert(data.payload.message);
      return;
    }
    if (data.type === 'chat') {
      addMessage(data.payload.sender, data.payload.text, data.payload.sender === ZH.system);
      return;
    }
    if (data.type === 'joined') {
      me = data.payload;
      selfInfo.textContent = `${ZH.userPrefix}${me.name} (${me.role === 'resident'
        ? `${ZH.residentShort}${me.homeFloor}${ZH.floorMark} ${ZH.doorplate}${me.doorplate}`
        : ZH.visitorShort})`;
      joinPanel.classList.add('hidden');
      chatPanel.classList.remove('hidden');
      return;
    }
    if (data.type === 'state') {
      syncState(data.payload);
    }
  };

  roleSelect.addEventListener('change', () => {
    residentFields.classList.toggle('hidden', roleSelect.value !== 'resident');
  });

  joinBtn.addEventListener('click', () => {
    const payload = {
      name: nameInput.value,
      role: roleSelect.value,
      areaId: areaSelect.value
    };
    if (roleSelect.value === 'resident') {
      payload.homeFloor = Number(homeFloorSelect.value);
      payload.doorplate = Number(doorplateSelect.value);
    }
    send('join', payload);
  });

  switchAreaBtn.addEventListener('click', () => {
    send('switch-area', { areaId: switchAreaSelect.value });
  });

  enterRoomBtn.addEventListener('click', () => {
    send('enter-room', { roomId: roomSelect.value });
  });

  sendBtn.addEventListener('click', () => {
    if (!messageInput.value.trim()) {
      return;
    }
    send('chat', { text: messageInput.value });
    messageInput.value = '';
  });
}

init();
